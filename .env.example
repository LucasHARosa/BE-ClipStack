# Copie para .env e ajuste. O .env não é versionado.

# ---------------------------------------------------------------- Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- Processamento
# FakeVideoProcessor (simulado) ou FfmpegVideoProcessor (precisa de ffmpeg/ffprobe no PATH)
VIDEO_PROCESSOR_CLASS=apps.processing.processors.FakeVideoProcessor
FAKE_PROCESSOR_STEP_SECONDS=1

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=clipstack
POSTGRES_USER=clipstack
POSTGRES_PASSWORD=clipstack
POSTGRES_PORT=5432
# Django rodando local (modo híbrido) fala com o Postgres do Docker pela porta publicada.
DATABASE_URL=postgres://clipstack:clipstack@localhost:5432/clipstack

# ---------------------------------------------------------------- Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- RabbitMQ / Celery
RABBITMQ_USER=clipstack
RABBITMQ_PASSWORD=clipstack
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://clipstack:clipstack@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------- CORS
# Origens do frontend que podem chamar a API pelo navegador (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:5173
