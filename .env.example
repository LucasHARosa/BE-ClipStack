# Copie para .env e ajuste. O .env não é versionado.

# ---------------------------------------------------------------- Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=clipstack
POSTGRES_USER=clipstack
POSTGRES_PASSWORD=clipstack
POSTGRES_PORT=5432
# Django rodando local (modo híbrido) fala com o Postgres do Docker pela porta publicada.
DATABASE_URL=postgres://clipstack:clipstack@localhost:5432/clipstack
